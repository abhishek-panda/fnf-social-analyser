    "winston": "^3.19.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
