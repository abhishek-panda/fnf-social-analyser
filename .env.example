# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Absolute path to the media download directory
MEDIA_PATH=/absolute/path/to/fnf-social-analyser/media

# ─── SSL (Tesco network only — see TROUBLESHOOT.md §1) ───────────────────────
# Single CA cert path — Node.js reads this natively at startup
# Python services derive REQUESTS_CA_BUNDLE/SSL_CERT_FILE/CURL_CA_BUNDLE from it at runtime
# Generate tesco-ca.crt locally — never commit it (gitignored)
NODE_EXTRA_CA_CERTS=/absolute/path/to/fnf-social-analyser/tesco-ca.crt

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fnf_social_analyser
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Instagram Graph API ──────────────────────────────────────────────────────
# Long-lived token — exchange short-lived token via Graph API Explorer
INSTAGRAM_ACCESS_TOKEN=your-long-lived-instagram-access-token
# ISO-8601 expiry — written back automatically by TokenRefreshService after each refresh
INSTAGRAM_TOKEN_EXPIRES_AT=
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_API_VERSION=v24.0
# Comma-separated list of hashtags to track (without #)
INSTAGRAM_TRACKED_HASHTAGS=fandfclothing,fandf
# How many days before token expiry to trigger a proactive refresh (default: 7)
TOKEN_REFRESH_DAYS_BEFORE_EXPIRY=7

# ─── Feed Collector ───────────────────────────────────────────────────────────
FEED_COLLECTOR_SERVICE_PORT=3000
RECENT_MEDIA_CRON_SCHEDULE=*/30 * * * *
TOP_MEDIA_CRON_SCHEDULE=*/30 * * * *
TOKEN_REFRESH_CRON_SCHEDULE=0 0 * * *

# ─── Image Search ─────────────────────────────────────────────────────────────
IMAGE_SEARCH_SERVICE_PORT=3001

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Embedding Service ────────────────────────────────────────────────────────
EMBEDDING_SERVICE_PORT=8000
EMBEDDING_SERVICE_URL=http://localhost:8000
# Set to false to disable embedding generation during ingestion
EMBEDDING_SERVICE_ENABLED=true
# Vision-language model used for embeddings (default: SigLIP)
CLIP_MODEL_ID=Marqo/marqo-fashionCLIP
# Set to 1 after model is downloaded to prevent network calls (faster startup, works offline)
HF_HUB_OFFLINE=0

# ─── LLM (embedding-service internal) ────────────────────────────────────────
# OpenAI-compatible base URL — defaults to local Ollama
OPENAI_BASE_URL=http://localhost:11434/v1
# API key — use 'ollama' for local Ollama, real key for OpenAI
OPENAI_API_KEY=ollama
# Model to use for caption cleaning
LLM_MODEL=llama3.2:3b
# Timeout in seconds for LLM requests
LLM_TIMEOUT=30
