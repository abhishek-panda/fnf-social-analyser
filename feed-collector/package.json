{
  "name": "feed-collector",
  "version": "1.0.0",
  "description": "FNF Social Feed Collector — ingests Instagram posts tagged with F&F hashtags and exposes them via REST API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../.env -- ts-node src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "tesco",
    "fnf",
    "instagram",
    "social-media"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.7.2",
    "bullmq": "^6.3.9",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fuse.js": "^7.0.0",
    "ioredis": "^6.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
